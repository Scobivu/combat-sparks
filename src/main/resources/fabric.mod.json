  "authors": [
    "Scobivu"
  ],
  "contact": {
    "sources": "https://github.com/Scobivu"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "scobivu.combatsparks.CombatSparksClient"
    ]
  },
  "mixins": [
    "combat-sparks.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  }
}
